---
// Plantilla para páginas de texto escritas en Markdown (soporte, privacidad…).
// El texto va sobre una «hoja» blanca con la misma cabecera de metadatos que el PDF.
import Base from './Base.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { getTexts, type Lang } from '../i18n';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Tipo de documento que sale en la cabecera, p. ej. «Support» */
    kind: string;
    updated: string;
    lang: Lang;
    /** La página sin idioma: 'support/' o 'privacy/' */
    route: string;
  };
}
const { frontmatter: fm } = Astro.props;
const t = getTexts(fm.lang);
---

<Base title={`${fm.title} · Tobokachi`} description={fm.description} lang={fm.lang} route={fm.route}>
  <Masthead t={t.masthead} lang={fm.lang} route={fm.route} />
  <main class="wrap">
    <article class="doc">
      <header>
        <h1>{fm.title}</h1>
        <dl class="meta">
          <div><dt class="label">{t.doc.document}</dt><dd>{fm.kind}</dd></div>
          <div><dt class="label">{t.doc.updated}</dt><dd>{fm.updated}</dd></div>
          <div><dt class="label">{t.doc.contact}</dt><dd><a href="mailto:vanitcode@icloud.com">vanitcode@icloud.com</a></dd></div>
        </dl>
      </header>
      <div class="body">
        <slot />
      </div>
    </article>
  </main>
  <Footer t={t.footer} lang={fm.lang} route={fm.route} cta={false} />
</Base>

<style>
  main { padding-top: 56px; padding-bottom: 96px; }
  .doc {
    max-width: 820px; margin: 0 auto; background: var(--paper); padding: 56px 64px 64px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04), 0 24px 50px -24px rgba(20, 20, 20, 0.28);
  }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 6vw, 64px); line-height: 1; letter-spacing: -0.03em; }
  .meta {
    display: flex; flex-wrap: wrap; gap: 12px 40px; margin-top: 32px; padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }
  .meta dd { font-size: 14px; font-weight: 700; margin-top: 2px; }
  .meta a { text-underline-offset: 3px; }

  /* Estilos del Markdown (los elementos los genera Astro, por eso :global) */
  .body { margin-top: 36px; font-size: 17px; line-height: 1.65; color: var(--text); }
  .body :global(h2) {
    font-family: var(--serif); font-weight: 700; font-size: 26px; line-height: 1.2; color: var(--ink);
    margin: 44px 0 12px; padding-top: 18px; border-top: 1px dashed var(--dash);
  }
  .body :global(h3) { font-family: var(--serif); font-weight: 700; font-size: 20px; color: var(--ink); margin: 28px 0 6px; }
  .body :global(p), .body :global(ul) { margin-bottom: 14px; }
  .body :global(ul) { padding-left: 22px; }
  .body :global(li) { margin-bottom: 6px; }
  .body :global(strong) { color: var(--ink); }
  .body :global(a) { color: var(--pen-blue); text-underline-offset: 3px; }
  .body :global(.lead) { font-size: 20px; color: var(--ink); }

  @media (max-width: 640px) {
    main { padding-top: 32px; }
    .doc { padding: 32px 22px 40px; }
  }
</style>
