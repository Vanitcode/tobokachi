---
// Esqueleto común de todas las páginas: <head> con todo lo de SEO y la carga de fuentes.
import { Font } from 'astro:assets';
import '../styles/global.css';
import { APP_STORE_URL } from '../i18n/en';
import { LANGS, DEFAULT_LANG, OG_LOCALES, localizedPath, type Lang } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** La página sin idioma: '' (portada), 'support/' o 'privacy/'. Sirve para enlazar sus traducciones. */
  route: string;
  /** Imagen para la vista previa al compartir, relativa a public/ (p. ej. "og.png") */
  image?: string;
}

const { title, description, lang, route, image } = Astro.props;
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(Astro.url.pathname);
const ogImage = image ? absolute(withBase(image)) : undefined;

// hreflang: le dice a Google qué versión de esta página corresponde a cada idioma
const alternates = LANGS.map((l) => ({ lang: l, href: absolute(localizedPath(l, route)) }));

// Datos estructurados: le dicen a Google que esta web describe una app
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Tobokachi',
  operatingSystem: 'iOS, iPadOS',
  applicationCategory: 'EducationalApplication',
  description,
  inLanguage: lang,
  image: absolute(withBase('icon-512.png')),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: APP_STORE_URL,
  author: { '@type': 'Person', name: 'Jose Carlos Valenzuela Nieto' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(localizedPath(DEFAULT_LANG, route))} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="theme-color" content="#ECECE8" />

    <!-- Banner de Safari en iPhone que ofrece abrir la app en la App Store -->
    <meta name="apple-itunes-app" content="app-id=6801584392" />

    <!-- Fuentes servidas desde la web; precargamos las que se ven nada más entrar -->
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <!-- Vista previa al compartir el enlace (WhatsApp, Reddit, X, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tobokachi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- #static en la URL: todo aparece ya terminado, sin animaciones (lo uso para hacer capturas) -->
    <script is:inline>if (location.hash === '#static') document.documentElement.setAttribute('data-static', '');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
