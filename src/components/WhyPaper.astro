---
// «Why paper»: tres razones, cada una marcada con un ✓ real de la hoja al llegar con el scroll,
// y la foto real de una hoja en una tablet e-ink, enmarcada como una tarjeta del PDF:
// la foto arriba, la línea discontinua y el pie de foto debajo, como la zona de respuesta.
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import einkPhoto from '../assets/photos/eink-tablet.jpg';
import check1 from '../assets/marks/check-1.png';
import check2 from '../assets/marks/check-2.png';
import check3 from '../assets/marks/check-3.png';

interface Props {
  t: {
    label: string;
    title: string;
    points: { title: string; text: string }[];
    photoAlt: string;
    caption: string;
  };
}
const { t } = Astro.props;
const checks = [check1, check2, check3];
---

<section class="why" id="why" data-why>
  <div class="wrap grid">
    <div>
      <SectionHead number={3} label={t.label} title={t.title} />
      <ul class="points">
        {t.points.map((p, i) => (
          <li style={`--delay: ${i * 0.12}s`}>
            <Image class="tick" src={checks[i % checks.length]} alt="" height={116} />
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <figure>
      <Image
        src={einkPhoto}
        alt={t.photoAlt}
        widths={[480, 760, 1100]}
        sizes="(max-width: 980px) 92vw, 480px"
        loading="lazy"
      />
      <figcaption>{t.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  // Cada razón se «corrige» con su ✓ cuando entra en pantalla. Sin JavaScript, los ✓ ya están.
  for (const why of document.querySelectorAll<HTMLElement>('[data-why]')) {
    if (document.documentElement.hasAttribute('data-static')) continue;
    why.classList.add('live');
    for (const li of why.querySelectorAll('li')) {
      new IntersectionObserver(
        (entries, observer) => {
          if (entries[0].isIntersecting) {
            li.classList.add('done');
            observer.disconnect();
          }
        },
        { threshold: 0.8 },
      ).observe(li);
    }
  }
</script>

<style>
  .why { border-top: 2px solid var(--ink); padding: 112px 0; }
  .grid { display: grid; grid-template-columns: 6fr 5fr; gap: 80px; align-items: center; }

  .points { list-style: none; border-top: 1.5px solid var(--ink); }
  .points li {
    display: grid; grid-template-columns: 52px 1fr; gap: 8px; padding: 24px 0;
    /* Separadas por la línea discontinua de las tarjetas */
    background: repeating-linear-gradient(90deg, var(--dash) 0 5px, transparent 0 10px) bottom / 100% 1px no-repeat;
  }
  .points :global(.tick) { height: 42px; width: auto; margin-top: -10px; }
  /* El ✓ se traza desde abajo a la izquierda, que es como se escribe */
  .why:global(.live) li :global(.tick) { clip-path: inset(100% 100% 0 0); }
  .why:global(.live) li:global(.done) :global(.tick) {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.5s cubic-bezier(0.45, 0.05, 0.35, 1) var(--delay);
  }
  h3 { font-family: var(--serif); font-weight: 700; font-size: 24px; line-height: 1.2; margin-bottom: 6px; }
  .points p { font-size: 17px; line-height: 1.55; color: var(--text); max-width: 34em; }

  /* La foto como una tarjeta del PDF: borde negro de 1,5, esquinas de 6 */
  figure { border: 1.5px solid var(--ink); border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  figure :global(img) { width: 100%; height: auto; }
  figcaption {
    padding: 12px 16px 14px; font-size: 14px; line-height: 1.45; color: var(--text);
    background: repeating-linear-gradient(90deg, var(--dash) 0 5px, transparent 0 10px) top / 100% 1px no-repeat;
  }

  @media (max-width: 980px) {
    .why { padding: 88px 0; }
    .grid { grid-template-columns: 1fr; gap: 56px; }
    figure { max-width: 520px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .why:global(.live) li :global(.tick) { clip-path: none; transition: none; }
  }
</style>
