---
// Preguntas frecuentes con <details>: se abren y cierran sin JavaScript.
import SectionHead from './SectionHead.astro';
import { localizedPath, type Lang } from '../i18n';
import type { Texts } from '../i18n/en';

interface Props {
  t: Texts['faq'];
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<section class="faq" id="faq">
  <div class="wrap grid">
    <div class="side">
      <SectionHead number={5} label={t.label} title={t.title} />
      <p class="more">{t.more} <a href={localizedPath(lang, 'support/')}>{t.contact}</a></p>
    </div>
    <div class="list">
      {t.items.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <span class="sign mono" aria-hidden="true" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { border-top: 2px solid var(--ink); padding: 96px 0 104px; }
  .grid { display: grid; grid-template-columns: 4fr 7fr; gap: 64px; align-items: start; }
  .side { position: sticky; top: 32px; }
  .more { margin-top: -36px; font-size: 16px; color: var(--text); }
  .more a { color: var(--pen-blue); text-underline-offset: 4px; }
  .list { border-top: 1.5px solid var(--ink); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex; justify-content: space-between; align-items: baseline; gap: 24px;
    padding: 22px 0; cursor: pointer; list-style: none;
    font-family: var(--serif); font-weight: 700; font-size: 21px; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .sign::before { content: '+'; font-size: 18px; font-weight: 400; color: var(--pen-blue); }
  details[open] .sign::before { content: '−'; }
  summary:hover span:first-child { text-decoration: underline; text-decoration-color: var(--pen-blue); text-underline-offset: 5px; }
  details p { padding: 0 48px 24px 0; font-size: 17px; line-height: 1.6; color: var(--text); max-width: 40em; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 0; }
    .side { position: static; margin-bottom: 40px; }
  }
</style>
