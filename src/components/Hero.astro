---
// Portada: titular con la última palabra rodeada a mano, entradilla y botón de descarga.
// A la derecha (slot) va la hoja con la tinta animada.
import AppStoreButton from './AppStoreButton.astro';
import type { Texts } from '../i18n/en';

interface Props {
  t: Texts['hero'];
}

const { t } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <p class="kicker mono">{t.kicker}</p>
      <h1>
        {t.titleStart}{t.titleOn && <><em>{t.titleOn}</em>&nbsp;</>}<span class="circled">{t.titleCircled}<svg
            viewBox="0 0 200 80"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path
              pathLength="1"
              d="M 30 62 C 8 52, 6 28, 34 16 C 70 2, 146 4, 178 20 C 200 32, 194 58, 160 68 C 118 80, 52 76, 26 60 C 14 52, 16 38, 40 26"
            ></path></svg
          ></span>
      </h1>
      <p class="lead">{t.lead}</p>
      <div class="cta-row">
        <AppStoreButton label={t.cta} apple />
        <span class="mono note">{t.note}</span>
      </div>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero { padding: 64px 0 88px; }
  .hero .wrap { display: grid; grid-template-columns: 5fr 6fr; gap: 64px; align-items: start; }
  .kicker { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--graphite); }
  h1 {
    font-family: var(--serif); font-weight: 400; font-size: clamp(48px, 7vw, 92px);
    line-height: 0.98; letter-spacing: -0.035em; margin: 22px 0 28px;
  }
  /* El círculo azul se dibuja solo, como un trazo de boli (provisional: luego irá un trazo tuyo) */
  .circled { position: relative; display: inline-block; white-space: nowrap; }
  .circled svg { position: absolute; left: -5%; top: -12%; width: 112%; height: 128%; overflow: visible; pointer-events: none; }
  .circled path {
    fill: none; stroke: var(--pen-blue); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 0.9s cubic-bezier(0.6, 0.05, 0.3, 1) 0.5s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .lead { font-size: 19px; line-height: 1.55; color: var(--text); max-width: 30em; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 34px; }
  .note { font-size: 12px; color: var(--graphite); }

  @media (max-width: 980px) { .hero .wrap { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 560px) { .hero { padding-top: 40px; } }
  @media (prefers-reduced-motion: reduce) { .circled path { animation: none; stroke-dashoffset: 0; } }
</style>
