---
// Portada: titular con la última palabra rodeada a mano, entradilla y botón de descarga.
// A la derecha (slot) va la hoja con la tinta animada. Debajo, una franja con los cuatro
// colores de valoración de la app: la fila 🫠 🤔 😌 🤩 de cada tarjeta, a lo ancho de la página.
import AppStoreButton from './AppStoreButton.astro';
import type { Texts } from '../i18n/en';

interface Props {
  t: Texts['hero'];
  /** Nombres de las cuatro valoraciones, en el orden de la app */
  ratings: string[];
}

const { t, ratings } = Astro.props;
const scale = [
  { face: '🫠', tint: 'again' },
  { face: '🤔', tint: 'hard' },
  { face: '😌', tint: 'good' },
  { face: '🤩', tint: 'easy' },
];
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <h1>
        {t.titleStart}{t.titleOn && <>{t.titleOn}&nbsp;</>}<span class="circled">{t.titleCircled}<svg
            viewBox="0 0 200 80"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path
              pathLength="1"
              d="M 30 62 C 8 52, 6 28, 34 16 C 70 2, 146 4, 178 20 C 200 32, 194 58, 160 68 C 118 80, 52 76, 26 60 C 14 52, 16 38, 40 26"
            ></path></svg
          ></span>
      </h1>
      <p class="lead">{t.lead}</p>
      <div class="cta-row">
        <AppStoreButton label={t.cta} apple />
        <span class="note">{t.note}</span>
      </div>
    </div>
    <div class="sheet-slot"><slot /></div>
  </div>
  <ul class="scale" role="list">
    {scale.map((s, i) => (
      <li style={`background: var(--${s.tint})`}>
        <span class="face" aria-hidden="true">{s.face}</span>
        <span class="name">{ratings[i]}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero { padding-top: 56px; }
  .hero .wrap { display: grid; grid-template-columns: 5fr 6fr; gap: 64px; align-items: start; }
  .copy { padding-top: 24px; }
  h1 {
    font-family: var(--serif); font-weight: 700; font-size: clamp(44px, 6vw, 84px);
    line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance; margin-bottom: 28px;
  }
  /* El círculo azul se dibuja solo, como un trazo de boli */
  .circled { position: relative; display: inline-block; white-space: nowrap; }
  .circled svg { position: absolute; left: -5%; top: -12%; width: 112%; height: 128%; overflow: visible; pointer-events: none; }
  .circled path {
    fill: none; stroke: var(--pen-blue); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 0.9s cubic-bezier(0.6, 0.05, 0.3, 1) 0.5s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .lead { font-size: 19px; line-height: 1.55; color: var(--text); max-width: 32em; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 34px; }
  .note { font-size: 14px; color: var(--graphite); }

  /* La hoja baja hasta pisar la franja de colores, como una hoja apoyada en la mesa */
  .sheet-slot { position: relative; z-index: 1; margin-bottom: -96px; }

  .scale { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); }
  .scale li { display: flex; align-items: flex-end; gap: 12px; min-height: 200px; padding: 0 var(--gutter) 28px; }
  .face { font-size: 30px; line-height: 1; }
  .name { font-size: 15px; font-weight: 600; color: var(--ink); }

  @media (max-width: 980px) {
    .hero .wrap { grid-template-columns: 1fr; gap: 40px; }
    .copy { padding-top: 0; }
    .sheet-slot { margin-bottom: -56px; }
    .scale li { min-height: 140px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 36px; }
    .scale { grid-template-columns: repeat(2, 1fr); }
    .scale li { min-height: 0; padding: 20px var(--gutter); }
    .scale li:nth-child(-n + 2) { padding-top: 76px; }
  }
  @media (prefers-reduced-motion: reduce) { .circled path { animation: none; stroke-dashoffset: 0; } }
</style>
