---
// Llamada final y pie. El pie copia el del PDF: regla, leyenda de las caras y «Page 1 / 1».
import { Image } from 'astro:assets';
import AppStoreButton from './AppStoreButton.astro';
import appIcon from '../assets/app-icon.png';
import { LANGS, LANG_NAMES, localizedPath, type Lang } from '../i18n';
import type { Texts } from '../i18n/en';

interface Props {
  t: Texts['footer'];
  lang: Lang;
  /** Página actual sin idioma, para que el selector lleve a la misma página en otro idioma */
  route: string;
  /** La llamada final solo va en la portada */
  cta?: boolean;
}
const { t, lang, route, cta = true } = Astro.props;
---

{cta && (
  <section class="final">
    <div class="wrap">
      <Image class="icon" src={appIcon} alt="Tobokachi" width={176} height={176} loading="lazy" />
      <h2 set:html={t.ctaTitle} />
      <p>{t.ctaText}</p>
      <AppStoreButton label={t.cta} apple />
    </div>
  </section>
)}

<footer>
  <div class="wrap">
    <div class="bar">
      <span class="legend">{t.legend}</span>
      <span class="page mono">{t.page}</span>
    </div>
    <div class="meta mono">
      <nav aria-label="Footer">
        {t.links.map((l) => <a href={localizedPath(lang, l.href)}>{l.label}</a>)}
      </nav>
      <nav class="langs" aria-label="Language">
        {LANGS.map((l) => (
          <a href={localizedPath(l, route)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {LANG_NAMES[l]}
          </a>
        ))}
      </nav>
    </div>
    <p class="made mono">{t.made}</p>
  </div>
</footer>

<style>
  .final { background: var(--paper); border-top: 2px solid var(--ink); padding: 96px 0 96px; text-align: center; }
  .final :global(.icon) {
    width: 88px; height: 88px; margin: 0 auto 32px;
    filter: drop-shadow(0 10px 18px rgba(0, 60, 140, 0.22));
  }
  .final h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(42px, 6vw, 76px); line-height: 1; letter-spacing: -0.03em; }
  .final p { font-size: 18px; color: var(--text); margin: 20px 0 32px; }

  footer { background: var(--paper); padding: 0 0 40px; }
  .bar {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    border-top: 1.5px solid var(--ink); padding-top: 10px;
  }
  .legend { font-size: 12px; font-style: italic; font-weight: 500; color: #595959; white-space: pre-wrap; }
  .page { font-size: 13px; font-weight: 700; white-space: nowrap; }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; margin-top: 28px; font-size: 12px; color: var(--graphite); }
  .meta nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .meta a { color: var(--ink); text-underline-offset: 3px; }
  .langs a { text-decoration: none; color: var(--graphite); }
  .langs a:hover { color: var(--ink); }
  .langs a[aria-current] { color: var(--ink); font-weight: 700; text-decoration: underline; text-decoration-color: var(--pen-blue); }
  .made { margin-top: 18px; font-size: 12px; color: var(--graphite); }
</style>
